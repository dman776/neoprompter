{
  "name": "neoprompter",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "description": "Teleprompter for a church live production team",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "node scripts/ensure-electron.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:check": "node scripts/check-installers.mjs",
    "prepare": "husky",
    "check": "npm run conventions && npm run typecheck && npm test",
    "pretest:e2e": "node scripts/ensure-electron.mjs",
    "test:e2e": "npm run build && vitest run --config e2e/vitest.config.ts",
    "conventions": "node scripts/check-conventions.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bold": "^3.35.0",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-heading": "^3.35.0",
    "@tiptap/extension-italic": "^3.35.0",
    "@tiptap/extension-paragraph": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "cfb": "^1.2.2",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
