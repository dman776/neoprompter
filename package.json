{
  "name": "neoprompter",
  "version": "0.1.0",
  "private": true,
  "description": "Teleprompter for a church live production team",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:check": "node scripts/check-installers.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3"
  }
}
